{
  "name": "fortuna-wealth-tracker",
  "private": true,
  "version": "1.2.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test scripts/*.test.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "play:assets": "node scripts/generate-play-assets.mjs",
    "demo:generate": "node scripts/generate-demo-data.mjs",
    "release:web": "npm run lint && npm run build && npx cap sync android",
    "release:android": "npm run lint && npm run build && npx cap sync android",
    "release:ios": "npm run lint && npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.3",
    "@capacitor/core": "^8.3.3",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.3.3",
    "@capacitor/share": "^8.0.1",
    "@ebarooni/capacitor-calendar": "^8.0.1",
    "dexie": "^4.4.2",
    "i18next": "^26.0.10",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.7",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
